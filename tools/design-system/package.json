{
    "name": "design-system-mirror",
    "private": true,
    "type": "module",
    "description": "React mirror of app/components/ui for the Claude Design system. See README.md.",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "node build.mjs && tailwindcss -i design.css -o out/bundle.css --minify",
        "build:dist": "node build-dist.mjs",
        "previews": "node gen.mjs",
        "dts": "node build-dist.mjs && node dts.mjs",
        "drift": "node classdiff.mjs",
        "build:claude-design": "cat out/tokens.css out/bundle.css > out/claude-design.css"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@radix-ui/react-avatar": "^1.2.6",
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-collapsible": "^1.1.20",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-navigation-menu": "^1.2.22",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-separator": "^1.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/forms": "^0.5.11",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^3.6.0",
        "embla-carousel-react": "^8.6.0",
        "esbuild": "^0.28.2",
        "lucide-react": "^1.49.0",
        "react": "^18.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.89.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "zod": "^3.25.76"
    }
}
